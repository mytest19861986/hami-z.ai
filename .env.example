# مسیر دیتابیس SQLite — روی سرور، مسیر مطلق پروژه را بگذارید:
# DATABASE_URL=file:/home/ubuntu/hami-card/db/custom.db
DATABASE_URL=file:/home/z/my-project/db/custom.db

# نمایش کد تأیید OTP روی صفحهٔ ورود (چون سرویس پیامک هنوز متصل نیست).
# روی سرور واقعی که اینترنت دارد، برای امنیت بیشتر مقدار false بگذارید و
# کد را از لاگ سرور (server.log — خط OTP) بخوانید؛ برای تست اولیه true راحت‌تر است.
SHOW_DEV_OTP=true

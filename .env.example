# HamiCard Environment Configuration

# Database Connection (SQLite or PostgreSQL 16)
# For SQLite (default development):
DATABASE_URL="file:./db/custom.db"
# For PostgreSQL 16 (production / local docker):
# DATABASE_URL="postgresql://hamicard_app:HamiCardDevPass2026Secure!@localhost:5432/hamicard_dev?schema=public"

# Redis Connection (Redis 7)
REDIS_URL="redis://localhost:6379"

# Authentication & JWT Secrets
JWT_SECRET="hamicard-super-secret-jwt-key-change-in-production-2026"
SESSION_SECRET="hamicard-session-encryption-key-min-32-chars-long"

# OTP Settings
OTP_EXPIRY_SECONDS=120
OTP_DEV_MOCK=true

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PWA_ENABLED=true
